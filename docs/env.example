# Cloudflare / Echo Garden Father’s Day MVP

# R2
R2_BUCKET_NAME=echo-garden-artworks
R2_PUBLIC_BASE_URL=https://assets.echo-garden.jp

# D1
D1_DATABASE_NAME=echo-garden-mvp
D1_DATABASE_ID=

# App
APP_BASE_URL=https://example.com
LP_BASE_URL=https://example.com/lp
CREATE_BASE_URL=https://example.com/create

# Office export
OFFICE_EXPORT_SECRET=replace-with-long-random-secret

# Limits
MAX_GENERATION_ATTEMPTS=2
MAX_MEDIA_DURATION_SECONDS=60
MAX_AUDIO_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=100

# Campaign
CAMPAIGN_SLUG=fathers-day-2026
